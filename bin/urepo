#!/usr/bin/env bash
# ==============================================================================
# urepo - Universal Linux Repository Client CLI
# Repository: https://sujitkumarbharti.github.io/repo
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

VERSION="1.0.0"
PRIMARY_URL="https://sujitkumarbharti.github.io/repo"
FALLBACK_URL="https://raw.githubusercontent.com/SujitKumarBharti/repo/main"

if [ "$EUID" -eq 0 ]; then
    CACHE_DIR="/var/lib/urepo"
elif [ -f "/var/lib/urepo/registry.json" ]; then
    CACHE_DIR="/var/lib/urepo"
else
    CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/urepo"
fi

REGISTRY_CACHE="$CACHE_DIR/registry.json"
INSTALLED_CACHE="/var/lib/urepo/installed.json"

# Detect OS family
detect_os() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        case "$ID" in
            ubuntu|debian|kali|linuxmint|pop|elementary|raspbian)
                echo "debian"
                return
                ;;
            fedora|rhel|centos|rocky|almalinux)
                echo "fedora"
                return
                ;;
            arch|manjaro|endeavouros|garuda|artix)
                echo "arch"
                return
                ;;
        esac

        # Check ID_LIKE
        for like in $ID_LIKE; do
            case "$like" in
                debian|ubuntu) echo "debian"; return ;;
                fedora|rhel) echo "fedora"; return ;;
                arch) echo "arch"; return ;;
            esac
        done
    fi

    if [ -f /etc/debian_version ]; then
        echo "debian"
    elif [ -f /etc/arch-release ]; then
        echo "arch"
    elif [ -f /etc/redhat-release ] || [ -f /etc/fedora-release ]; then
        echo "fedora"
    else
        echo "universal"
    fi
}

CURRENT_OS=$(detect_os)

# Check sudo / root
require_root() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}❌ Error: This command requires superuser privileges. Please run with sudo:${NC}"
        echo -e "${CYAN}   sudo urepo $1${NC}"
        exit 1
    fi
}

# Download file with primary URL + fallback
fetch_url() {
    local rel_path="$1"
    local output_file="$2"
    
    # Try Primary URL (GitHub Pages)
    if curl -fsSL --connect-timeout 5 "$PRIMARY_URL/$rel_path" -o "$output_file" 2>/dev/null; then
        return 0
    fi

    # Fallback to Raw GitHub
    if curl -fsSL --connect-timeout 8 "$FALLBACK_URL/$rel_path" -o "$output_file" 2>/dev/null; then
        return 0
    fi

    return 1
}

# Update registry cache
cmd_update() {
    echo -e "${BLUE}🔄 Updating package registry from repository...${NC}"
    mkdir -p "$CACHE_DIR"
    local temp_file=$(mktemp)

    if fetch_url "database/registry.json" "$temp_file"; then
        mv "$temp_file" "$REGISTRY_CACHE"
        chmod 644 "$REGISTRY_CACHE" 2>/dev/null || true
        echo -e "${GREEN}✅ Repository registry updated successfully.${NC}"
        
        local count
        count=$(python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
    print(len(data.get("packages", [])))
except:
    print("0")
' "$REGISTRY_CACHE")
        echo -e "   Total packages available: ${BOLD}$count${NC}"
    else
        rm -f "$temp_file"
        echo -e "${RED}❌ Failed to fetch registry from repository.${NC}"
        echo "   Please check your internet connection."
        exit 1
    fi
}

ensure_cached_registry() {
    if [ ! -f "$REGISTRY_CACHE" ]; then
        cmd_update
    fi
}

# Print header
show_header() {
    echo -e "${CYAN}${BOLD}"
    echo "  ╔═══════════════════════════════════════════════════════════════╗"
    echo "  ║          UREPO - UNIVERSAL LINUX PACKAGE MANAGER              ║"
    echo "  ║          https://sujitkumarbharti.github.io/repo              ║"
    echo "  ╚═══════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

# Show help
cmd_help() {
    show_header
    echo -e "${BOLD}SYSTEM:${NC} Detected OS Family: ${GREEN}$CURRENT_OS${NC}"
    echo ""
    echo -e "${BOLD}USAGE:${NC}"
    echo "  urepo <command> [arguments]"
    echo ""
    echo -e "${BOLD}COMMANDS:${NC}"
    echo -e "  ${GREEN}list${NC}                      List all packages available for this system"
    echo -e "  ${GREEN}search <term>${NC}             Search packages by keyword"
    echo -e "  ${GREEN}info <package>${NC}            View package details and version info"
    echo -e "  ${GREEN}install <package>${NC}         Download and install a package (requires sudo)"
    echo -e "  ${GREEN}remove <package>${NC}          Uninstall a package (requires sudo)"
    echo -e "  ${GREEN}update${NC}                    Update local package database cache"
    echo -e "  ${GREEN}version${NC}                   Show urepo version"
    echo -e "  ${GREEN}help${NC}                      Show this help screen"
    echo ""
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo "  urepo search omen"
    echo "  sudo urepo install omen-gaming-hub"
    echo "  urepo info omen-gaming-hub"
    echo "  sudo urepo remove omen-gaming-hub"
    echo ""
}

# List packages
cmd_list() {
    ensure_cached_registry
    echo -e "${BLUE}${BOLD}📦 Available Packages (OS: ${GREEN}$CURRENT_OS${BLUE}):${NC}\n"

    python3 -c '
import json, sys

with open(sys.argv[1]) as f:
    data = json.load(f)

packages = data.get("packages", [])
current_os = sys.argv[2]

if not packages:
    print("  (No packages currently in repository)")
    sys.exit(0)

print("  {:<24} {:<10} {:<12} {:<35}".format("NAME", "VERSION", "TYPE", "DESCRIPTION"))
print("  " + "-"*80)

for p in packages:
    os_type = p.get("os_type", "universal")
    desc = p.get("description", "")
    if len(desc) > 32:
        desc = desc[:29] + "..."
    name = p["name"]
    ver = p.get("version", "-")
    print("  {:<24} {:<10} {:<12} {:<35}".format(name, ver, os_type, desc))
' "$REGISTRY_CACHE" "$CURRENT_OS"
    echo ""
}

# Search packages
cmd_search() {
    local query="$1"
    if [ -z "$query" ]; then
        echo -e "${RED}Usage: urepo search <term>${NC}"
        exit 1
    fi

    ensure_cached_registry
    echo -e "${BLUE}${BOLD}🔍 Searching for: '$query'${NC}\n"

    python3 -c '
import json, sys

with open(sys.argv[1]) as f:
    data = json.load(f)

query = sys.argv[2].lower()
current_os = sys.argv[3]
packages = data.get("packages", [])
matches = [p for p in packages if query in p["name"].lower() or query in p.get("description", "").lower()]

if not matches:
    print("  No packages matching query found.")
else:
    for p in matches:
        p_os = p.get("os_type", "universal")
        compat = " (Compatible with your OS)" if p_os in [current_os, "universal"] else " (Built for " + p_os + ")"
        print("  • {} (v{}) [{}]{}".format(p["name"], p.get("version", "-"), p_os, compat))
        print("    Desc: {}".format(p.get("description", "-")))
        print("    Install: sudo urepo install {}\n".format(p["name"]))
' "$REGISTRY_CACHE" "$query" "$CURRENT_OS"
}

# Info on package
cmd_info() {
    local pkg_name="$1"
    if [ -z "$pkg_name" ]; then
        echo -e "${RED}Usage: urepo info <package-name>${NC}"
        exit 1
    fi

    ensure_cached_registry
    python3 -c '
import json, sys

with open(sys.argv[1]) as f:
    data = json.load(f)

pkg_name = sys.argv[2]
current_os = sys.argv[3]
packages = data.get("packages", [])

matches = [p for p in packages if p["name"] == pkg_name]
if not matches:
    print("Package \"{}\" not found in repository.".format(pkg_name))
    sys.exit(1)

pkg = next((p for p in matches if p.get("os_type") == current_os), None)
if not pkg:
    pkg = next((p for p in matches if p.get("os_type") == "universal"), matches[0])

print("\n" + "="*60)
print("  Package:     {}".format(pkg["name"]))
print("  Version:     {}".format(pkg.get("version", "-")))
print("  Target OS:   {}".format(pkg.get("os_type", "universal")))
print("  File:        {}".format(pkg.get("filename", "-")))
print("  SHA256:      {}".format(pkg.get("sha256", "-")))
print("  Updated:     {}".format(pkg.get("updated_at", "-")))
print("  Description: {}".format(pkg.get("description", "-")))
print("="*60 + "\n")
' "$REGISTRY_CACHE" "$pkg_name" "$CURRENT_OS"
}

# Install package
cmd_install() {
    local pkg_name="$1"
    if [ -z "$pkg_name" ]; then
        echo -e "${RED}Usage: sudo urepo install <package-name>${NC}"
        exit 1
    fi

    require_root "install $pkg_name"
    ensure_cached_registry

    # Find matching package
    local pkg_info
    pkg_info=$(python3 -c '
import json, sys

with open(sys.argv[1]) as f:
    data = json.load(f)

pkg_name = sys.argv[2]
current_os = sys.argv[3]
packages = data.get("packages", [])
matches = [p for p in packages if p["name"] == pkg_name]

if not matches:
    print("NOT_FOUND")
    sys.exit(0)

target = next((p for p in matches if p.get("os_type") == current_os), None)
if not target:
    target = next((p for p in matches if p.get("os_type") == "universal"), None)

if not target:
    avail_os = ", ".join([p.get("os_type", "") for p in matches])
    print("INCOMPATIBLE:" + avail_os)
    sys.exit(0)

print("{}|{}|{}|{}|{}|{}".format(
    target["name"],
    target.get("version", ""),
    target.get("os_type", ""),
    target.get("filepath", ""),
    target.get("sha256", ""),
    target.get("filename", "")
))
' "$REGISTRY_CACHE" "$pkg_name" "$CURRENT_OS")

    if [ "$pkg_info" == "NOT_FOUND" ]; then
        echo -e "${RED}❌ Error: Package '$pkg_name' not found in repository.${NC}"
        echo "Run 'urepo search $pkg_name' or 'urepo update' to refresh registry."
        exit 1
    elif [[ "$pkg_info" =~ ^INCOMPATIBLE: ]]; then
        local avail=$(echo "$pkg_info" | cut -d: -f2)
        echo -e "${YELLOW}⚠️  Package '$pkg_name' is not built for your current OS ($CURRENT_OS).${NC}"
        echo -e "   Available builds exist for: ${CYAN}$avail${NC}"
        exit 1
    fi

    IFS='|' read -r name version os_type filepath sha256 filename <<< "$pkg_info"

    echo -e "${CYAN}${BOLD}📥 Downloading $name (v$version) for $os_type...${NC}"
    local tmp_dir=$(mktemp -d)
    local download_dest="$tmp_dir/$filename"

    if ! fetch_url "$filepath" "$download_dest"; then
        echo -e "${RED}❌ Failed to download package file from repository!${NC}"
        rm -rf "$tmp_dir"
        exit 1
    fi

    # Verify Checksum
    echo -e "${BLUE}🔒 Verifying integrity checksum (SHA-256)...${NC}"
    local actual_sha256
    actual_sha256=$(sha256sum "$download_dest" | awk '{print $1}')

    if [ "$actual_sha256" != "$sha256" ]; then
        echo -e "${RED}❌ Checksum mismatch! Corrupt or tampered package.${NC}"
        echo "   Expected: $sha256"
        echo "   Actual:   $actual_sha256"
        rm -rf "$tmp_dir"
        exit 1
    fi
    echo -e "${GREEN}✓ Integrity verified.${NC}"

    # Install according to type
    echo -e "${CYAN}⚙️  Installing $name on system...${NC}"
    local installed_type=""

    if [[ "$filename" == *.deb ]] || [ "$os_type" == "debian" ]; then
        installed_type="deb"
        dpkg -i "$download_dest" || apt-get install -f -y
    elif [[ "$filename" == *.rpm ]] || [ "$os_type" == "fedora" ]; then
        installed_type="rpm"
        if command -v dnf >/dev/null 2>&1; then
            dnf install -y "$download_dest"
        else
            rpm -Uvh --replacepkgs "$download_dest"
        fi
    elif [[ "$filename" == *.pkg.tar* ]] || [ "$os_type" == "arch" ]; then
        installed_type="arch"
        pacman -U --noconfirm "$download_dest"
    elif [[ "$filename" == *.AppImage ]]; then
        installed_type="appimage"
        mkdir -p /usr/local/bin
        cp "$download_dest" "/usr/local/bin/$name"
        chmod +x "/usr/local/bin/$name"
    else
        # Standalone binary or script
        installed_type="binary"
        mkdir -p /usr/local/bin
        cp "$download_dest" "/usr/local/bin/$name"
        chmod +x "/usr/local/bin/$name"
    fi

    # Record installed metadata
    python3 -c '
import json, os, datetime, sys

cache_file = sys.argv[1]
name = sys.argv[2]
version = sys.argv[3]
installed_type = sys.argv[4]

os.makedirs(os.path.dirname(cache_file), exist_ok=True)
data = {}
if os.path.isfile(cache_file):
    try:
        with open(cache_file) as f:
            data = json.load(f)
    except:
        pass

data[name] = {
    "version": version,
    "type": installed_type,
    "installed_at": datetime.datetime.now(datetime.timezone.utc).isoformat()
}

with open(cache_file, "w") as f:
    json.dump(data, f, indent=2)
' "$INSTALLED_CACHE" "$name" "$version" "$installed_type"

    rm -rf "$tmp_dir"
    echo ""
    echo -e "${GREEN}${BOLD}🎉 Package '$name' (v$version) installed successfully!${NC}"
}

# Remove package
cmd_remove() {
    local pkg_name="$1"
    if [ -z "$pkg_name" ]; then
        echo -e "${RED}Usage: sudo urepo remove <package-name>${NC}"
        exit 1
    fi

    require_root "remove $pkg_name"
    echo -e "${YELLOW}🗑️  Uninstalling $pkg_name...${NC}"

    # Check installed record
    local pkg_type=""
    if [ -f "$INSTALLED_CACHE" ]; then
        pkg_type=$(python3 -c '
import json, sys
cache_file = sys.argv[1]
name = sys.argv[2]
try:
    with open(cache_file) as f:
        data = json.load(f)
    print(data.get(name, {}).get("type", ""))
except:
    pass
' "$INSTALLED_CACHE" "$pkg_name")
    fi

    case "$pkg_type" in
        deb)
            apt-get remove -y "$pkg_name" || dpkg -r "$pkg_name"
            ;;
        rpm)
            if command -v dnf >/dev/null 2>&1; then
                dnf remove -y "$pkg_name"
            else
                rpm -e "$pkg_name"
            fi
            ;;
        arch)
            pacman -R --noconfirm "$pkg_name"
            ;;
        appimage|binary)
            rm -f "/usr/local/bin/$pkg_name"
            ;;
        *)
            # Fallback guessing by current OS
            if [ "$CURRENT_OS" == "debian" ]; then
                dpkg -r "$pkg_name" 2>/dev/null || apt-get remove -y "$pkg_name" 2>/dev/null || rm -f "/usr/local/bin/$pkg_name"
            elif [ "$CURRENT_OS" == "fedora" ]; then
                dnf remove -y "$pkg_name" 2>/dev/null || rm -f "/usr/local/bin/$pkg_name"
            elif [ "$CURRENT_OS" == "arch" ]; then
                pacman -R --noconfirm "$pkg_name" 2>/dev/null || rm -f "/usr/local/bin/$pkg_name"
            else
                rm -f "/usr/local/bin/$pkg_name"
            fi
            ;;
    esac

    # Remove from record
    if [ -f "$INSTALLED_CACHE" ]; then
        python3 -c '
import json, sys
cache_file = sys.argv[1]
name = sys.argv[2]
try:
    with open(cache_file) as f:
        data = json.load(f)
    if name in data:
        del data[name]
        with open(cache_file, "w") as f:
            json.dump(data, f, indent=2)
except:
    pass
' "$INSTALLED_CACHE" "$pkg_name"
    fi

    echo -e "${GREEN}✅ Package '$pkg_name' removed successfully.${NC}"
}

# Main routing
case "$1" in
    install)
        shift
        cmd_install "$@"
        ;;
    remove|uninstall)
        shift
        cmd_remove "$@"
        ;;
    search)
        shift
        cmd_search "$@"
        ;;
    info)
        shift
        cmd_info "$@"
        ;;
    list)
        cmd_list
        ;;
    update)
        cmd_update
        ;;
    version|--version|-v)
        echo "urepo v$VERSION (Universal Linux Repository Manager)"
        ;;
    help|--help|-h|"")
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        cmd_help
        exit 1
        ;;
esac
